# LLM provider for this agent's own reasoning calls. Platform is running on Groq
# (Llama 3.3 70B) — not to be confused with xAI's Grok model, similar name only.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM_PROVIDER=xai
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4
