# Caddy automatically provisions and renews HTTPS certificates from Let's Encrypt.
# Replace YOUR_DOMAIN with your actual domain (e.g. agentmarket.xyz).

{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    # API calls → backend (backend already mounts all routes under /api)
    reverse_proxy /api/* backend:8000

    # SDK callbacks (no /api prefix — contract §6)
    reverse_proxy /jobs/* backend:8000

    # Everything else → React frontend
    reverse_proxy /* frontend:80
}
