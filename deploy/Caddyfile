# Caddy reverse proxy — generated by setup.sh.
# If DOMAIN is an IP address, HTTP only (no SSL). If it's a real domain, Caddy
# auto-provisions HTTPS from Let's Encrypt automatically.

{$CADDY_BIND} {
    reverse_proxy /api/*  backend:8000
    reverse_proxy /jobs/* backend:8000
    reverse_proxy /*      frontend:80
}
