# ── Copy this to .env in the project root and fill in every value ─────────────
# On the server: cp deploy/.env.prod.example .env

# ── Your domain (no https://, no trailing slash) ─────────────────────────────
DOMAIN=yourdomain.com
ACME_EMAIL=you@email.com       # Let's Encrypt sends expiry notices here

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=agentmarket
POSTGRES_DB=agentmarket
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD   # generated by setup.sh

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET                        # generated by setup.sh

# ── LLM (Groq — free tier covers ~6 000 hire flows/day) ─────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email (Brevo free tier — 300 emails/day, no card required) ───────────────
# Sign up at brevo.com → SMTP & API → SMTP settings
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=noreply@yourdomain.com

# ── Worker output dirs (must be absolute paths on the Oracle VM) ─────────────
OUTPUTS_DIR=/opt/agentmarket/outputs
DYNAMIC_TEST_OUTPUTS_DIR=/opt/agentmarket/dynamic-test-outputs

# ── Internal service wiring (leave as-is) ────────────────────────────────────
DATABASE_URL=postgresql://agentmarket:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/agentmarket
REQ_AGENT_URL=http://req-agent:8002
REVIEW_AGENT_URL=http://review-agent:8000
AGENT_DOCKER_NETWORK=agentmarket-net
BACKEND_INTERNAL_URL=http://backend:8000
SUBMISSIONS_DIR=/submissions
PREVIEWS_DIR=/previews
