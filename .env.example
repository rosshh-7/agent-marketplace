# ============================================================================
# Agent Marketplace — root environment file
#
# Copy this to `.env` in the repo root (same directory as docker-compose.yml)
# and fill in real values. `docker compose up` reads `.env` automatically.
# See README.md for the full bring-up sequence.
# ============================================================================


# ---------------------------------------------------------------------------
# Postgres (service: postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=agentmarket
POSTGRES_PASSWORD=localdev
POSTGRES_DB=agentmarket


# ---------------------------------------------------------------------------
# Backend (service: backend, marketplace-platform/backend)
# Full var list per PLATFORM_CONTRACT.md §10 + backend/app/config.py
# (BACKEND_INTERNAL_URL / PREVIEWS_DIR are backend-internal additions, not in
# the original contract — see marketplace-platform/backend/README.md).
# ---------------------------------------------------------------------------
# Must match the Postgres creds above — kept as separate literal keys (rather
# than interpolated from POSTGRES_* ) so this file works with plain `docker
# compose --env-file` substitution with no nested-variable assumptions.
DATABASE_URL=postgresql://agentmarket:localdev@postgres:5432/agentmarket

JWT_SECRET=dev-secret-change-me

# Docker-network-resolvable base URLs of the two upstream agents (contract §5/§4).
REQ_AGENT_URL=http://req-agent:8002
REVIEW_AGENT_URL=http://review-agent:8000

# Name of the shared user-defined bridge network every worker container is attached
# to so it can call back to `http://backend:8000` (contract §6). Must match the
# `docker-compose.yml` top-level `networks:` block's fixed `name:` — NOT the
# project-prefixed name Compose would otherwise generate.
AGENT_DOCKER_NETWORK=agentmarket-net

# Fills the SDK's `AGENTMARKET_API` env var for launched worker containers — the
# backend's own base URL as seen from *inside* a worker container on the Docker
# network (backend-internal addition, not in the original contract; see
# backend/app/config.py::BACKEND_INTERNAL_URL).
BACKEND_INTERNAL_URL=http://backend:8000

# Container-internal storage paths. No sibling-container ever reads these, so
# (unlike OUTPUTS_DIR below) they do NOT need to be real, absolute host paths —
# docker-compose.yml backs them with plain named volumes for persistence.
SUBMISSIONS_DIR=/submissions
PREVIEWS_DIR=/previews

# --- IDENTITY BIND MOUNT #1 — worker container output visibility -----------
# Worker containers (launched by the backend via the Python `docker` SDK against
# the *host* Docker daemon, reached through the /var/run/docker.sock mount) write
# their result to /outputs/{job_id}/... — a path hardcoded in every worker image
# via agentmarket_sdk/sdk.py (frozen, cannot be changed; see complete()/
# upload_file()). After a worker calls back to POST /jobs/{id}/complete, the
# backend must open that *exact same file* from inside its own container.
#
# Mechanics (verified against backend/app/services/docker_launcher.py): the
# backend hands this value directly to the host Docker daemon as the bind-mount
# SOURCE when it does `client.containers.run(..., volumes={OUTPUTS_DIR: {"bind":
# "/outputs"}})` for a worker — so it MUST be a real absolute path that exists on
# the actual Docker host filesystem (not merely inside a container namespace).
# docker-compose.yml bind-mounts this same host path into the *backend's own*
# container at the fixed container path `/outputs` (the same path hardcoded in
# the SDK) — so whatever a worker writes, the backend can read back immediately.
#
# MUST be an ABSOLUTE path. A true root-level path (e.g. literally `/outputs`)
# will usually be rejected by Docker Desktop's file-sharing allowlist on macOS
# ("mounts denied: the path ... is not shared from the host") — keep it under
# your home directory / this repo checkout. Default below assumes this repo is
# checked out at /Users/roshan/roshan/code/agent-marketplace; change the prefix
# if you cloned it elsewhere.
OUTPUTS_DIR=/Users/roshan/roshan/code/agent-marketplace/.docker-data/outputs

# LLM provider passed through to every worker container the backend launches,
# and to req-agent. Running on Groq (Llama 3.3 70B) here — note this is NOT the
# same thing as xAI's Grok model, despite the similar name.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Only read if you flip LLM_PROVIDER above to "anthropic" / "xai":
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4

# SMTP — defaults point at the bundled Mailhog service, no credentials needed.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agentmarket.local

# Used to build the completion-email link ({FRONTEND_BASE_URL}/dashboard/jobs/{id})
# and as the CORS allow-origin for the browser-facing frontend.
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Frontend (service: frontend, marketplace-platform/frontend)
# ---------------------------------------------------------------------------
# Baked into the static bundle at BUILD time (webpack DefinePlugin) — this nginx
# container serves a plain static SPA with no runtime /api proxy (see
# frontend/nginx.conf), so this must be an absolute URL the *browser* can reach,
# i.e. the backend's host-published port — not the Docker-network service name
# `http://backend:8000`, which only resolves for other containers, not for code
# running in the user's browser.
API_BASE_URL=http://localhost:8000


# ---------------------------------------------------------------------------
# req-agent (service: req-agent, req-agent/) — already a standalone service;
# reuses LLM_PROVIDER/XAI_API_KEY/XAI_MODEL from the backend section above.
# See req-agent/.env.example / req-agent/docker-compose.yml (unmodified).
# ---------------------------------------------------------------------------
# (no additional vars — port 8002, persists ./req-agent/data + ./req-agent/output)


# ---------------------------------------------------------------------------
# review-agent (service: review-agent, review-agent/) — already a standalone
# service. Its own judge-LLM defaults to groq here, matching the
# platform-wide default above (review-agent's own standalone README/config
# defaults to Anthropic instead, since it's meant to run with whatever key you
# have on hand for local testing — this compose file overrides that default so
# the whole stack runs on a single GROQ_API_KEY). Override with
# REVIEW_AGENT_LLM_PROVIDER if you'd rather run its judge on anthropic/xai.
# ---------------------------------------------------------------------------
REVIEW_AGENT_LLM_PROVIDER=groq

# --- IDENTITY BIND MOUNT #2 — review-agent's own sandboxed test containers -
# Same trick as OUTPUTS_DIR above, already implemented in review-agent's own
# docker-compose.yml (this root compose file replicates that service verbatim
# plus this var): review-agent launches short-lived Docker containers on the
# host daemon to dynamic-test a seller's submission and needs to read their
# output back. MUST be an absolute host path that exists — see
# review-agent/app/config.py::DYNAMIC_TEST_OUTPUTS_DIR and
# review-agent/docker-compose.yml for the canonical pattern this mirrors.
DYNAMIC_TEST_OUTPUTS_DIR=/Users/roshan/roshan/code/agent-marketplace/review-agent/.dynamic-test-outputs


# ---------------------------------------------------------------------------
# Host port overrides (optional)
# ---------------------------------------------------------------------------
# Every published port below defaults to the canonical value used throughout
# PLATFORM_CONTRACT.md and every agent's own README. Only set these if one is
# already taken by something else on your machine — they change the HOST side of
# the mapping only; inter-container traffic on agentmarket-net is unaffected
# (containers always talk to each other via their container-internal ports).
# If you change BACKEND_PORT or FRONTEND_PORT, also update API_BASE_URL and
# FRONTEND_BASE_URL above to match, since those are consumed by the browser.
#
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# REQ_AGENT_PORT=8002
# REVIEW_AGENT_PORT=8010
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025
